{
  "name": "@voltip/shared",
  "version": "0.0.0",
  "private": true,
  "description": "IPC contract (zod), Backend interface, the Tauri backend; the in-memory mock (./mock) and typed fixtures for the browser preview and tests.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock-backend.ts",
    "./fixtures": "./src/fixtures/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
