# Copy to .env.build (git-ignored). Baked into the clients at compile time via option_env!;
# see docs/dictation.md §3. Never commit real values.
VOLTIP_ASR_URL=https://asr.example.test
VOLTIP_ASR_TOKEN=replace-me
VOLTIP_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
VOLTIP_REFINE_URL=https://api.groq.com/openai/v1
VOLTIP_REFINE_MODEL=qwen/qwen3.8-27b
VOLTIP_REFINE_API_KEY=replace-me
# Auto-update: the static manifest the shell polls (tauri-plugin-updater) and the minisign public key
# matching the CI secret TAURI_SIGNING_PRIVATE_KEY. Leave both empty to ship without an updater.
VOLTIP_UPDATE_URL=https://updates.example.test/latest.json
VOLTIP_UPDATE_PUBKEY=replace-me
# Relay the paired devices meet through when they are not on the same LAN (wss://<relay-host>/ws).
# Empty in a release build = no relay (LAN pairing only); debug builds fall back to ws://127.0.0.1:47830/ws.
VOLTIP_RELAY_URL=wss://relay.example.test/ws
# Words the production-host guard looks for in the tree (.github/scripts/check-no-production-hosts.sh):
# the hosts above, or their distinctive labels, space- or comma-separated. Never committed.
VOLTIP_PRODUCTION_HOSTS=
# Optional, local only: the Windows machine scripts/windows-remote.sh builds and tests on.
# VOLTIP_WINDOWS_SSH=-F ~/.ssh/config win-build
# VOLTIP_WINDOWS_DIR=C:\voltip-ci
