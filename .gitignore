/target
/dist/
node_modules/
coverage/
/lcov.info
*.tsbuildinfo
apps/*/src-tauri/gen/schemas/
apps/desktop/dist/*
!apps/desktop/dist/.gitkeep
apps/mobile/dist/*
!apps/mobile/dist/.gitkeep
__pycache__/
*.pyc
/verify-all.log

# Tauri Android: the Gradle project is committed; build outputs and the jniLibs symlink are not.
apps/mobile/src-tauri/gen/android/app/src/main/jniLibs/
.env.build
.ruff_cache/
# smoke run app logs and summaries next to the screenshots (CI artefacts only: they name the
# machine, its paths and the commit)
docs/acceptance/screens/tauri/*-app.log
docs/acceptance/screens/tauri/*-summary.txt
# sherpa-onnx runtime DLLs / .so files staged by apps/desktop/src-tauri/build.rs for the Windows
# and Linux bundles (tauri.windows.conf.json / tauri.linux.conf.json)
apps/desktop/src-tauri/resources/windows/
apps/desktop/src-tauri/resources/THIRD-PARTY-NOTICES.txt
apps/desktop/src-tauri/resources/linux/
apps/desktop/src-tauri/resources/macos/
# scripts/smoke-native-cli.ps1 output (make smoke-native, CI)
/smoke-native-*/
/smoke-native-cli/
