{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voltip",
  "version": "../../../package.json",
  "identifier": "dev.voltip.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voltip",
        "width": 1152,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Voltip",
    "category": "Utility",
    "shortDescription": "Voice input with end-to-end encrypted device pairing",
    "macOS": { "hardenedRuntime": true },
    "windows": { "nsis": { "installMode": "both" } }
  }
}
