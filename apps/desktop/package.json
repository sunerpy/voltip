{
  "name": "@voltip/desktop",
  "version": "0.1.7",
  "private": true,
  "description": "Voltip desktop webview (Windows / macOS).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
