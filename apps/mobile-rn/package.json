{
  "name": "@voltip/mobile-rn",
  "version": "0.0.0",
  "private": true,
  "description": "Voltip phone app on React Native (Android, acceptance build; docs/mobile-rn.md).",
  "license": "AGPL-3.0-or-later",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --platform android --clean --no-install",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src modules/voltip-native/src && tsc --noEmit",
    "test": "jest",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@material/material-color-utilities": "0.4.0",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@voltip/shared": "workspace:*",
    "expo": "58.0.10",
    "expo-build-properties": "58.0.10",
    "expo-camera": "58.0.10",
    "expo-file-system": "58.0.9",
    "expo-font": "58.0.8",
    "expo-haptics": "58.0.6",
    "expo-image-picker": "58.0.10",
    "expo-localization": "58.0.4",
    "expo-navigation-bar": "58.0.4",
    "expo-splash-screen": "58.0.9",
    "expo-status-bar": "58.0.3",
    "expo-system-ui": "58.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "5.15.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "babel-preset-expo": "58.0.14",
    "jest": "30.5.2",
    "jest-expo": "58.0.10",
    "test-renderer": "1.2.0",
    "typescript": "7.0.2"
  }
}
