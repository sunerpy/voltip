<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The phone as the computer's microphone (docs/dictation.md §20). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The relay link checks its socket when the network changes (docs/pairing.md 「重连」):
         VoltipNativeModule's network callback. A normal permission, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The floating bubble (docs/dictation.md §20.12): a talk button over other apps, recording
         while another app is in front from a foreground service of the microphone type, with a
         notification that closes it (BubbleService). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="dev.voltip.rn.BubbleService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Optional, consent-based accessibility paste into the user's focused editor. -->
        <service
            android:name="dev.voltip.rn.BubblePasteService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/voltip_bubble_accessibility_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/voltip_bubble_accessibility" />
        </service>
        <!-- History exports go to the share sheet as files (VoltipHost.shareFile). -->
        <provider
            android:name="dev.voltip.rn.VoltipFileProvider"
            android:authorities="${applicationId}.voltip.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/voltip_file_paths" />
        </provider>
    </application>
</manifest>
