{
  "name": "voltip-workspace",
  "version": "0.1.8",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "description": "Voltip web workspace: UI kit, IPC contract, desktop and mobile webviews.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @voltip/desktop dev",
    "dev:mobile": "pnpm --filter @voltip/mobile dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "patchedDependencies": {
      "react-native-paper@5.15.3": "patches/react-native-paper@5.15.3.patch"
    }
  }
}
